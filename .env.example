# Export these in your shell or explicitly pass --env-file /absolute/path/to/.env.
# Optional: enter these in the browser on first account-tool call instead.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
# macOS 13+ uses the bundled TDLib (Apple Silicon and Intel) automatically.
# Override only for a custom build or another platform:
# TDLIB_LIBRARY_PATH=/absolute/path/to/libtdjson.dylib
# Optional; defaults to an OS-specific user data directory, outside this repo.
# TELEGRAM_DATA_DIR=/absolute/path/to/private/telegram-mcp
# Optional database encryption key, used on every login and server launch.
# TELEGRAM_DATABASE_KEY=your_long_random_key
# TELEGRAM_REQUEST_TIMEOUT=30
# Account tools wait for browser login; set the MCP client's tool timeout above this.
# TELEGRAM_LOGIN_TIMEOUT=300
# Stop the shared backend after this many idle seconds; 0 keeps it running.
# TELEGRAM_IDLE_TIMEOUT=300
